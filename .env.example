# Server Configuration
PORT=4000
HOST=0.0.0.0

# Map Routing Provider ('KAKAO' | 'MOCK')
MAP_PROVIDER=KAKAO
KAKAO_REST_API_KEY=

# LLM Provider for Context Classification ('GEMINI' | 'OPENAI' | 'RULE_ONLY')
AI_PROVIDER=GEMINI
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=1500

# LiveKit WebRTC Media Server
LIVEKIT_URL=ws://localhost:7880
# Mac LAN IP (ipconfig getifaddr en0). 와이파이 바뀌면 갱신
LIVEKIT_NODE_IP=
# 로컬 docker 전용 개발 키. 공개 배포 시 반드시 교체
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_pleos_syncdrive_2026_devkey_32chars
